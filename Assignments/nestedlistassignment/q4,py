#Print the row which element is maximum
arr=[[1,2,3,4],
      [5,6,8,9],
      [2,6,7,8]]
max_sum=0
max_row=0

for i in range(len(arr)):
    sum=0

    for j in range(len(arr[i])):
      sum=sum+arr[i][j]
    if sum > max_sum:
        max_sum=sum
        max_row=i
print('Maximum sum row is:',max_row)
print('Sum:',max_sum)